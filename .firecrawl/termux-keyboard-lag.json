              os.system("killall %s" % panel_process_name)
              os.system("killall nm-applet")
              os.system("kill %d" % self.fb_pid)
              os.waitpid(self.fb_pid, 0)
              self.restart_cinnamon()
          else:
              Gtk.main_quit()
  
  if __name__ == "__main__":
